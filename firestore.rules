rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;}
  function room(id){return get(/databases/$(database)/documents/games/$(id)).data;}
  function after(id){return getAfter(/databases/$(database)/documents/games/$(id)).data;}
  function eventAfter(id,n){return getAfter(/databases/$(database)/documents/games/$(id)/events/$(string(n))).data;}
  function member(r){return signed()&&request.auth.uid in r.members;}
  function controls(r,actor){return signed()&&(actor==request.auth.uid||(r.owner==request.auth.uid&&actor in r.bots));}
  function validRoom(r){return r.keys().hasOnly(['version','owner','members','bots','phase','revision'])&&r.version==1&&r.owner is string&&r.members is list&&r.members.size()>=1&&r.members.size()<=5&&r.members.toSet().size()==r.members.size()&&r.owner in r.members&&r.bots is list&&r.bots.toSet().hasOnly(r.members.toSet())&&r.phase in ['lobby','angels','judgment','play','inspect','dance','after-turn','round-end','ended']&&r.revision is int&&r.revision>=1;}
  function validCommand(c){return c is map&&c.keys().hasAll(['type'])&&c.keys().hasOnly(['type','name','seed','id','angel','tiles','target','groups','opening','stage','power','communionTile','turn','foretell','tile','count','rank','zeal'])&&c.type in ['create','join','bot','start','angel','judgment-choice','rack','organize','draw','keep','communion','before','dance-choice','continue','next-round'];}
  match /games/{id} {
   allow get:if signed();
   allow list,delete:if false;
   allow create:if signed()&&validRoom(request.resource.data)&&request.resource.data.owner==request.auth.uid&&request.resource.data.members==[request.auth.uid]&&request.resource.data.bots==[]&&request.resource.data.phase=='lobby'&&request.resource.data.revision==1&&eventAfter(id,1).command.type=='create';
   allow update:if signed()&&validRoom(request.resource.data)&&request.resource.data.version==resource.data.version&&request.resource.data.owner==resource.data.owner&&request.resource.data.revision==resource.data.revision+1&&(
    (eventAfter(id,request.resource.data.revision).command.type=='join'&&resource.data.phase=='lobby'&&request.resource.data.phase=='lobby'&&!(request.auth.uid in resource.data.members)&&request.resource.data.members==resource.data.members.concat([request.auth.uid])&&request.resource.data.bots==resource.data.bots)
    ||(eventAfter(id,request.resource.data.revision).command.type=='bot'&&resource.data.phase=='lobby'&&request.resource.data.phase=='lobby'&&request.auth.uid==resource.data.owner&&request.resource.data.members==resource.data.members.concat([eventAfter(id,request.resource.data.revision).command.id])&&request.resource.data.bots==resource.data.bots.concat([eventAfter(id,request.resource.data.revision).command.id]))
    ||(member(resource.data)&&request.resource.data.members==resource.data.members&&request.resource.data.bots==resource.data.bots&&eventAfter(id,request.resource.data.revision).command.type!='join'&&eventAfter(id,request.resource.data.revision).command.type!='bot')
   );
   match /events/{sequence} {
    allow read:if member(room(id));
    allow update,delete:if false;
    allow create:if signed()&&request.resource.data.keys().hasOnly(['version','sequence','id','actor','command','createdAt'])&&request.resource.data.version==1&&request.resource.data.id is string&&request.resource.data.id.size()>0&&request.resource.data.id.size()<=128&&request.resource.data.actor is string&&request.resource.data.sequence is int&&sequence==string(request.resource.data.sequence)&&request.resource.data.createdAt==request.time&&validCommand(request.resource.data.command)&&request.resource.data.sequence==after(id).revision&&controls(after(id),request.resource.data.actor)&&(
     (request.resource.data.sequence==1&&request.resource.data.command.type=='create'&&after(id).owner==request.auth.uid)
     ||(request.resource.data.sequence>1&&request.resource.data.sequence==room(id).revision+1&&((request.resource.data.command.type=='join'&&request.resource.data.actor==request.auth.uid)||(member(room(id))&&request.resource.data.command.type!='create')))
    );
   }
  }
 }
}
