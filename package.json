{
  "name": "higher-powers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun run catalog && vite dev --host 127.0.0.1 --port 5198 --strictPort",
    "catalog": "bun scripts/catalog.ts",
    "art:prepare": "bun scripts/prepare-art.ts",
    "check": "bun run catalog && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "build": "bun run catalog && vite build && bun scripts/finalize-build.ts",
    "review": "bun scripts/review.ts",
    "prepare": "svelte-kit sync",
    "art:layers": "bun scripts/export-layers.ts",
    "book:export": "bun scripts/print-rulebook.ts",
    "art:digital": "bun scripts/prepare-digital-art.ts",
    "review:digital": "bun scripts/review-digital.ts",
    "review:magnetism": "bun scripts/review-magnetism.ts",
    "emulators": "bun scripts/firebase.ts emulators:start --only auth,firestore,database --project demo-higher-powers",
    "dev:emulators": "VITE_FIREBASE_EMULATORS=true bun run dev",
    "test:backend": "bun scripts/firebase.ts emulators:exec --only auth,firestore,database --project demo-higher-powers \"bun test tests/backend\"",
    "review:play": "bun scripts/review-play.ts",
    "review:jokers": "bun scripts/review-jokers.ts",
    "review:fullscreen": "bun scripts/review-fullscreen.ts",
    "review:selection": "bun scripts/review-rack-selection.ts",
    "review:snapping": "bun scripts/review-rack-snap.ts",
    "review:computers": "bun scripts/review-computer-moves.ts",
    "review:layout": "bun scripts/review-heaven-layout.ts",
    "review:invites": "bun scripts/review-invites.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.2.8",
    "@fontsource/cormorant-garamond": "5.2.11",
    "firebase": "^13.4.0",
    "marked": "^16.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/bun": "^1.3.0",
    "firebase-tools": "^15.37.0",
    "sharp": "^0.35.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
